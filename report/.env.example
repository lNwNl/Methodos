# LLM 配置
LLM_PROVIDER=openai          # openai | anthropic | ollama

# OpenAI 配置
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic 配置
ANTHROPIC_API_KEY=sk-ant-...

# Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434

# 模型配置
MODEL_NAME=gpt-4o            # 或 claude-3-5-sonnet, llama3
TEMPERATURE=0.7

# 服务配置
API_HOST=0.0.0.0
API_PORT=8001
