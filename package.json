{
  "name": "methodos",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/executor/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:css": "npx @tailwindcss/cli -i static/input.css -o static/output.css",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "better-sqlite3": "^12.0.0",
    "dockerode": "^5.0.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.8.5",
    "pino": "^10.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
